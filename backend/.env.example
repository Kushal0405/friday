# AI_PROVIDER selects which AI backend FRIDAY uses:
#   ollama        - local Ollama server, OpenAI-compatible API, no cost
#   anthropic_cli - shells out to the Claude Code CLI using your Claude subscription
#                   (not billed per-token; requires `claude` on PATH and logged in)
#   race          - fires Ollama and the Claude CLI at once, uses whichever answers
#                   first, cancels the other (default)
AI_PROVIDER=race

AI_API_KEY=
AI_MODEL=llama3.1
AI_BASE_URL=http://localhost:11434/v1

# Only used when AI_PROVIDER=anthropic_cli. Accepts a model alias (sonnet,
# opus, fable, haiku) or a full model id.
ANTHROPIC_CLI_MODEL=sonnet

WHISPER_MODEL=medium

FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8765

WAKE_WORD=friday
